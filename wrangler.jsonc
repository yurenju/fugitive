{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fugitive",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  // push 時最先碰到的限制是 CPU（見 #3 的研究），開到平台允許的最大值。
  "limits": { "cpu_ms": 300000 },
  "observability": { "enabled": true },
  // 第一段還沒有註冊與登入：這裡放一個使用者和他的一把使用者金鑰（公鑰）。
  // 第二段有了登記使用者金鑰的 API 之後拿掉。CHALLENGE_SECRET 是 secret，不放這裡。
  "vars": {
    "USER_NAME": "yurenju",
    "USER_KEY": "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIPeLr73gx9mk+jwdYi6QHYu/XnNpJNN/VXFzXadKVhSi"
  },
  "durable_objects": {
    "bindings": [{ "name": "REPOSITORY", "class_name": "Repository" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Repository"] }],
  "r2_buckets": [{ "binding": "PACKS", "bucket_name": "fugitive-packs" }]
}
